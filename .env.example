# Copy to .env and fill in. NEVER commit .env — it is gitignored; keep it that way.
# Keys arrive in Phase 1 (T006): Alpaca PAPER keys only until PROJECT_SPEC.md §7.4 is satisfied.

# Also accepted: ALPACA_API_KEY / ALPACA_SECRET_KEY (alias names)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_PAPER=true

# Macro context (T080): free key from https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Fundamentals + forward earnings calendar (T023/T023b, D030/D034): free key
# from https://site.financialmodelingprep.com. The FREE tier answers the
# forward earnings calendar, 5-year statements, balance sheet, profile
# (sector), and analyst estimates — probe-verified from this machine
# (scripts/fmp_check.py). Past calendar windows, news, and transcripts are
# paywalled: KUBERA works without them (D034 — free first; upgrades are
# just a new key on this line, zero code changes).
FMP_API_KEY=

# Schwab Trader API (T016, D026) — READ-ONLY: KUBERA observes this account and
# never trades it. App key + secret come from your approved app at
# developer.schwab.com. The refresh token comes from a one-time browser
# authorisation and expires roughly weekly — re-run scripts/schwab_auth.py when
# a call starts failing with "token refresh failed".
# The account number is optional and is NOT a credential; it only selects which
# account when the login holds several.
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
# Must match the app's registered callback EXACTLY (https required, even for
# localhost). https://127.0.0.1 is the usual choice and needs no local server —
# the browser lands on an error page and you copy the URL. See scripts/schwab_auth.py.
SCHWAB_CALLBACK_URL=https://127.0.0.1
# Obtained by running: python scripts/schwab_auth.py --write   (expires ~weekly)
SCHWAB_REFRESH_TOKEN=
SCHWAB_ACCOUNT_NUMBER=

# Risk limits (T115) — OPTIONAL overrides; defaults shown. These are RAILS:
# raising one is a decision, not a tweak. A value outside the allowed range
# refuses to start with a named error (never silently clamped). Sells are
# never blocked by any of these.
# KUBERA_DAILY_LOSS_LIMIT_FRAC=0.03    # halt at -3% from day-start equity
# KUBERA_MAX_POSITION_FRAC=0.20        # per-symbol cap as fraction of equity
# KUBERA_COOLDOWN_HOURS=20             # breaker reset lockout (commitment device)
# KUBERA_RISK_PER_TRADE_FRAC=0.01      # max loss if the ATR stop is hit
# KUBERA_STOP_ATR_MULTIPLE=2.0
# KUBERA_MAX_BUYS_PER_DAY=5            # order-frequency rail (T065b)

# Optional: Base URL overrides for sandbox, mock, or proxy environments (T107, D028).
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# OPENAI_BASE_URL=https://api.openai.com/v1
# ALPACA_DATA_BASE_URL=https://data.alpaca.markets
# FRED_BASE_URL=https://api.stlouisfed.org
# SCHWAB_BASE_URL=https://api.schwabapi.com
# SCHWAB_AUTH_URL=https://api.schwabapi.com/v1/oauth/authorize
# SCHWAB_TOKEN_URL=https://api.schwabapi.com/v1/oauth/token

# SEC EDGAR etiquette (T083b/T084): the SEC requires a contact address in
# the User-Agent of automated clients and blocks anonymous ones. Used ONLY
# in the UA header — never logged, never committed. This one free line
# unlocks years of past earnings dates with exact filing clocks (base
# rates) AND the full earnings press-release text (get_earnings_release),
# keylessly, straight from the SEC.
EDGAR_CONTACT=you@example.com
