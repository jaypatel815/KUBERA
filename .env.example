# Copy to .env and fill in. NEVER commit .env — it is gitignored; keep it that way.
# Keys arrive in Phase 1 (T006): Alpaca PAPER keys only until PROJECT_SPEC.md §7.4 is satisfied.

# Also accepted: ALPACA_API_KEY / ALPACA_SECRET_KEY (alias names)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_PAPER=true

# Macro context (T080): free key from https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Schwab Trader API (T016, D026) — READ-ONLY: KUBERA observes this account and
# never trades it. App key + secret come from your approved app at
# developer.schwab.com. The refresh token comes from a one-time browser
# authorisation and expires roughly weekly — re-run scripts/schwab_auth.py when
# a call starts failing with "token refresh failed".
# The account number is optional and is NOT a credential; it only selects which
# account when the login holds several.
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_REFRESH_TOKEN=
SCHWAB_ACCOUNT_NUMBER=
