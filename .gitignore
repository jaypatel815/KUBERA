# Secrets — never commit
.env
*.pem

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Data & builds
*.sqlite3
dist/
node_modules/

# OS/editor noise
.DS_Store
Thumbs.db
backups/

# Local models (large binaries)
models/
*.onnx
*.bin

# ---------------------------------------------------------------------------
# PRIVATE FINANCIAL DOCUMENTS — never commit (D026, T102)
# This repo is PUBLIC. A brokerage statement carries the account number, every
# holding, and the balance. Belt AND braces: the whole directory is ignored, and
# so is every PDF/CSV anywhere in the tree, because the one that gets committed
# is always the one dropped somewhere nobody thought to ignore.
private/
*.pdf
*.csv
!backend/tests/fixtures/**/*.csv     # redacted test fixtures stay tracked

# The live Claude Desktop config belongs in %APPDATA%\Claude\, not here. A copy
# in the repo root is a sign someone edited the wrong file — ignored so it cannot
# be committed and mistaken for the real one. The template lives in
# scripts/mcp_server.py's docstring.
claude_desktop_config.json

# I029 probe outputs — orderIds/positionIds are semi-sensitive; repo is public
out_put.txt
*_output.txt
