# Secrets — never commit
.env
*.pem

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Data & builds
*.sqlite3
dist/
node_modules/

# OS/editor noise
.DS_Store
Thumbs.db
backups/

# Local models (large binaries)
models/
*.onnx
*.bin

# ---------------------------------------------------------------------------
# PRIVATE FINANCIAL DOCUMENTS — never commit (D026, T102)
# This repo is PUBLIC. A brokerage statement carries the account number, every
# holding, and the balance. Belt AND braces: the whole directory is ignored, and
# so is every PDF/CSV anywhere in the tree, because the one that gets committed
# is always the one dropped somewhere nobody thought to ignore.
private/
*.pdf
*.csv
!backend/tests/fixtures/**/*.csv     # redacted test fixtures stay tracked
